{% extends "layouts/normal.njk" %}

{% block content %}
<section>
  <div class="row-left-350">
    <img src="{{ imgSrc }}" alt="{{ page.data.title or title }}">
    <div class="text-container">
      <h2>{{ title | safe }}</h2>
        <ul>
          <li>Release date: {{ releaseDate }}</li>
          <li>Genre: {{ genre }}</li>
          <li>Featuring: {{ featuring }}</li>
          <li>Runtime: {{ runtime }}</li>
        </ul>
        {{ content | safe }}
    </div>
  </div>
  	<a href="../cds.html">Back...</a>
</section>
{% endblock %}